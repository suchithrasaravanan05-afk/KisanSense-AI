# ==============================================================================
# KisanSense AI — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development or set these variables in
# the Vercel Dashboard under Project Settings > Environment Variables.
#
# IMPORTANT: NEVER commit real API keys, secrets, or `.env.local` to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision Model Provider Configuration
# ------------------------------------------------------------------------------
# Options:
#   - 'demo'   : Safe agronomic offline heuristics + verified sample leaf fixtures (Default).
#   - 'gemini' : Live Google Gemini Multimodal Vision API (requires GEMINI_API_KEY).
#   - 'openai' : Live OpenAI Vision API (requires OPENAI_API_KEY).
VISION_PROVIDER=demo

# Request timeout in milliseconds for upstream vision models (default: 15000)
VISION_TIMEOUT_MS=15000

# When true, gracefully falls back to deterministic agronomic triage if upstream API times out or fails
VISION_FALLBACK_TO_DEMO=true

# ------------------------------------------------------------------------------
# 2. Google Gemini Vision API (Multimodal Triage)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. OpenAI Vision API (Alternative Multimodal Triage)
# ------------------------------------------------------------------------------
# Obtain an API key from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Supabase Cloud Database & Authentication (Optional)
# ------------------------------------------------------------------------------
# Obtain these credentials from your Supabase Dashboard > Project Settings > API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostgreSQL Direct Connection String (for Prisma, Drizzle, or raw migrations):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. Application & Server Settings
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
